# База данных (для docker-compose)
DATABASE_URL=postgresql://postgres:password@db:5432/blog_db

# База данных (для локального postgres)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/blog_db

# JWT секрет (ОБЯЗАТЕЛЬНО ИЗМЕНИ!)
SECRET_KEY=super-secret-key-change-this-for-production-1234567890

# CORS для фронтенда (React/Vue)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173